# Copy to bridge.env (not committed) and edit. Sourced by bin/*.sh and written into the generated compose.yml.
# Base URL of your Fluxer instance:
FLUXER_INSTANCE=https://your-fluxer.example
# Container name prefix (containers are <prefix>-<owner>):
# BB_PREFIX=fab
# Image tag built from ./image:
# BB_IMAGE=fluxer-agent-bridge:local
# Compose project name. When upgrading a host that already runs containers, keep its old project name:
# BB_COMPOSE_PROJECT=fluxer-agent-bridge
