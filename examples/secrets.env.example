# Per-bot secrets: owners/<owner>/<bot>/secrets.env (mode 600, owned by the owner's container uid).
# Never commit this file. Write it with bin/add-bot.sh (values on stdin), not by hand, so nothing lands in shell history.
FLUXER_BOT_TOKEN=<app_id>.<secret>
WEBHOOK_URL=https://agent.example/hooks/fluxer
# Full Authorization header value sent with every POST (optional):
WEBHOOK_AUTH=Bearer <your-webhook-key>
# Legacy alternative, sent as "Bearer <key>" plus X-Automation-Key:
# WEBHOOK_KEY=<key>
